# Exclude all projects in apps, code, and src folders
apps/*
!apps/.gitkeep
code/*
!code/.gitkeep
src/*
!src/.gitkeep

# DevOps & Traefik live runtime configurations
network/traefik/acme.json
network/traefik/users.htpasswd
platform/network/traefik/acme.json
platform/network/traefik/users.htpasswd
docker-registry/data/
docker-registry/auth/htpasswd
!docker-registry/auth/.gitkeep
docker/registry/data/
docker/registry/auth/htpasswd
!docker/registry/auth/.gitkeep

# Volumes: Ignore all dynamic company-specific application and mobile folders
volumes/
docker/volumes/
!docker/volumes/db/pgadmin-config/
!docker/volumes/db/pgadmin-config/**
!docker/volumes/apps/.gitkeep
!docker/volumes/apk/.gitkeep
!docker/volumes/artifacts/.gitkeep
!docker/volumes/infra/registry/.gitkeep

# Compiled mobile package binaries and artifacts
*.apk
*.aab
*.ipa
*.aar

# Database dumps & compressed archives
*.dump
*.sql.gz
*.tar.gz
*.zip
build.log
*.log

# CI server cache folders
ci-server/
docker/volumes/ci-cache/

# DevOps Manager temporary files and build folders
devops-manager/api/backups/
**/bin/
**/obj/
**/TestResults/

# Node / Web build artifacts and dependencies
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
.turbo/
.cache/
coverage/
**/coverage/

# IDE and OS files
.vs/
.vscode/
.idea/
*.suo
*.user
.DS_Store
Thumbs.db

# Local environment secrets
.env
.env.local
.env.backup*
__pycache__/
*.pyc
*.key
*.db
*.sqlite
*.sqlite3
*.db-journal
